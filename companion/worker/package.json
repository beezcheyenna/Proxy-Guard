{
  "name": "proxy-guard-vps-access",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "deploy": "wrangler deploy",
    "check:bundle": "wrangler deploy --dry-run --outdir dist",
    "test:persistence": "python3 -B test/persistence_test.py"
  },
  "cloudflare": {
    "bindings": {
      "DEVICE_ID": {
        "description": "Device ID configured on OpenWrt."
      },
      "DEVICE_TOKEN": {
        "description": "Random per-device secret; use at least 32 base64url characters."
      },
      "AGENT_SECRET": {
        "description": "Separate random secret shared only with the VPS agent."
      },
      "VPS_API": {
        "description": "Existing Workers VPC Service connected to the loopback-only VPS agent through cloudflared."
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.156.0",
    "miniflare": "5.20261023.3-beta"
  },
  "license": "MIT"
}
