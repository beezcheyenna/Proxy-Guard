{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxy-guard-vps-access",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DEVICE_ID": "home"
  },
  "vpc_services": [
    {
      "binding": "VPS_API",
      "service_id": "REPLACE_WITH_EXISTING_VPC_SERVICE_ID"
    }
  ],
  "observability": {
    "enabled": false
  },
  "secrets": {
    "required": [
      "DEVICE_TOKEN",
      "AGENT_SECRET"
    ]
  }
}
