#!/sbin/openrc-run
description="Proxy Guard VPS access policy receiver"
command="/usr/bin/python3"
command_args="/opt/proxy-guard-access/agent.py --config /etc/proxy-guard-access/agent.json"
command_user="root"
supervisor="supervise-daemon"
respawn_delay=3
respawn_max=5
respawn_period=600
umask=0077
depend() {
    need localmount proxy-guard-access-policy
    after modules nftables firewall
}
start_pre() {
    checkpath -d -m 0700 /run/proxy-guard-access /var/lib/proxy-guard-access
}
