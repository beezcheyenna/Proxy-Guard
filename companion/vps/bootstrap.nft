add table inet pg_vps_access_boot
delete table inet pg_vps_access_boot
table inet pg_vps_access_boot {
 set dynamic4 { type ipv4_addr; flags timeout; }
 set ssh_last4 { type ipv4_addr; }
 set ssh_static4 { type ipv4_addr; flags interval; auto-merge; }
 set dynamic6 { type ipv6_addr; flags timeout; }
 set ssh_last6 { type ipv6_addr; }
 set ssh_static6 { type ipv6_addr; flags interval; auto-merge; }
 set ssh_managed { type inet_service; }
 set ssh_hold { type inet_service; flags timeout; }
 set ssh_public { type inet_service; flags timeout; }
 chain input {
  type filter hook input priority -150; policy accept;
  iifname "lo" return
  ct direction reply ct state established return
 }
}
