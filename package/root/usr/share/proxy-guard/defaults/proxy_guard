config proxy_guard 'main'
    option enabled '0'
    option setup_complete '0'
    option mode 'monitor'
    option proxy_client 'auto'
    option client_auto_ports '0'
    option passwall_watch '0'
    option passwall_log_watch '0'
    option passwall_log_interval '1'
    option boot_guard '0'
    option passwall_trigger 'any'
    option fast_wait_enabled '1'
    option fast_wait_seconds '15'
    option fast_stable_enabled '1'
    option fast_stable_seconds '60'
    option schedule_enabled '0'
    option schedule_utc_offset '+00:00'
    list interfaces 'br-lan'
    list sources4 '192.0.2.0/24'
    option ipv6_protect '1'
    list sources6 '::/0'
    list local4 '192.0.2.0/24'
    list local4 '198.51.100.0/24'
    list local4 '10.20.0.0/24'
    list local6 'fd00::/64'
    list proxy_ports '1070'
    list dns_ports '53'
    option socks_port '1070'
    option exit_check 0
    option exit_source manual
    option expected_exit4 ''
    option exit_url 'https://api.ipify.org/'
    option cf_event_check '1'
    option interval '10'
    option timeout '4'
    option fail_threshold '3'
    option recover_threshold '2'
    option startup_grace '150'
    option min_success '1'
    list targets 'https://www.gstatic.com/generate_204|204'
    list targets 'https://www.google.com/generate_204|204'
    option log_kib '64'
    option debug '0'
    option self_heal '1'
    option self_heal_stale '30'
    option self_heal_cooldown '60'
    option self_heal_limit '3'
    option self_heal_window '600'
    option resource_monitor '1'
    option udp_check '0'
    option udp_server ''
    option udp_port '53'
    option udp_query 'example.com'
    option udp_timeout '3'
