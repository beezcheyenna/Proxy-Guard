#!/bin/sh
umask 077
while :; do
    if mv /var/run/proxy-guard/setup-apply-request /var/run/proxy-guard/setup-apply-request.running 2>/dev/null; then
        read -r pg_setup_generation < /var/run/proxy-guard/setup-apply-request.running
        rm -f /var/run/proxy-guard/setup-apply-request.running
        case "$pg_setup_generation" in
            ''|*[!a-zA-Z0-9-]*) ;;
            *) /etc/init.d/proxy-guard apply_config "$pg_setup_generation" >/dev/null 2>&1 </dev/null & ;;
        esac
    fi
    if [ -e /etc/proxy-guard/setup/pending.json ]; then
        ucode /usr/lib/proxy-guard/setup-lock.uc tick >/dev/null 2>&1
        sleep 1
    else
        if [ -f /etc/proxy-guard/setup/confirmed ] && ! cmp -s /etc/config/proxy_guard /etc/proxy-guard/setup/confirmed; then
            ucode /usr/lib/proxy-guard/setup-lock.uc observe >/dev/null 2>&1
        fi
        sleep 3
    fi
done

