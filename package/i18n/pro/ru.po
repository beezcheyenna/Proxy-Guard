msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\nLanguage: ru\n"

msgid "VPS access rules (Pro)"
msgstr "Правила доступа к VPS (Pro)"

msgid "proxy-guard-pro:0 keeps emergency SSH open until household authorization is restored. Use 30 to 3600 for a timed window."
msgstr "0 оставляет аварийный SSH открытым до восстановления авторизации домашнего IP. Для ограничения времени укажите от 30 до 3600 секунд."

msgid "proxy-guard-pro:A confirmation action is already being verified."
msgstr "Результат действия подтверждения уже проверяется."

msgid "proxy-guard-pro:A maintenance operation is already pending."
msgstr "Операция по техническому обслуживанию уже находится на рассмотрении."

msgid "proxy-guard-pro:A missing or failed remote health report withholds the local access permit. Local proxy checks remain required."
msgstr "Если отчёт о состоянии VPS отсутствует или содержит ошибку, локальное разрешение доступа не выдаётся. Локальные проверки прокси по-прежнему обязательны."

msgid "proxy-guard-pro:Add at least one address to an enabled static whitelist."
msgstr "Добавьте хотя бы один адрес в включенный статический белый список."

msgid "proxy-guard-pro:Address families"
msgstr "Семейства адресов"

msgid "proxy-guard-pro:Agent HTTPS address through the proxy"
msgstr "Адрес HTTPS агента через прокси"

msgid "proxy-guard-pro:Agent started"
msgstr "Agent запущен"

msgid "proxy-guard-pro:All sources keeps standard resource limits active. Household and static addresses are allowed in whitelist mode and exempt from standard limits. Legacy bypass disables this rule protection."
msgstr "Для всех источников действуют стандартные ресурсные ограничения. Домашние и статические адреса разрешены в белом списке и освобождены от стандартных ограничений. Старый вариант обхода отключает защиту этого правила."

msgid "proxy-guard-pro:All sources, resource limits apply"
msgstr "Все источники с применением ресурсных ограничений"

msgid "proxy-guard-pro:Allow rebooting the VPS"
msgstr "Разрешить перезагрузку VPS"

msgid "proxy-guard-pro:Allow restarting the proxy core"
msgstr "Разрешить перезапуск прокси-ядра"

msgid "proxy-guard-pro:Allowed or exempt sources"
msgstr "Разрешённые или освобождённые от ограничений источники"

msgid "proxy-guard-pro:Analysis Agent connected"
msgstr "Аналитический агент подключен"

msgid "proxy-guard-pro:Analysis reports observations and suspicion only. A repeated payload does not identify the sender as GFW. Full packet capture and the honeypot are off by default and configured on the Agent."
msgstr "Анализ сообщает только о наблюдениях и подозрениях. Повтор содержимого пакета не доказывает принадлежность отправителя к GFW. Полный захват пакетов и honeypot по умолчанию отключены и настраиваются в Agent."

msgid "proxy-guard-pro:Another VPS policy change is awaiting confirmation."
msgstr "Другое изменение политики VPS ожидает подтверждения."

msgid "proxy-guard-pro:Another session is confirming the VPS policy."
msgstr "Другой сеанс подтверждает политику VPS."

msgid "proxy-guard-pro:Another settings update is in progress; retry shortly."
msgstr "Еще одно обновление настроек продолжается; повторите в ближайшее время."

msgid "proxy-guard-pro:Bandwidth threshold duration (seconds)"
msgstr "Длительность превышения порога полосы (сек.)"

msgid "proxy-guard-pro:Both heartbeats lost for (seconds)"
msgstr "Оба контрольных сигнала отсутствуют (сек.)"

msgid "proxy-guard-pro:Bypass all protection (legacy behavior)"
msgstr "Обход всей защиты (совместимость со старой настройкой)"

msgid "proxy-guard-pro:Bytes observed"
msgstr "Байты, наблюдаемые"

msgid "proxy-guard-pro:Cannot read confirmation status. The VPS rollback timer continues."
msgstr "Не удалось получить состояние подтверждения. Таймер отката VPS продолжает работать."

msgid "proxy-guard-pro:Cannot read synchronization status; retrying automatically."
msgstr "Не удалось прочитать состояние синхронизации; повторная попытка выполняется автоматически."

msgid "proxy-guard-pro:Changes take effect after Save & Apply. Stopping synchronization does not remove VPS rules. Dynamic authorizations expire; configured resource limits and SSH rescue remain in effect."
msgstr "Изменения действуют после нажатия «Сохранить и применить». Остановка синхронизации не удаляет правила VPS. Динамические разрешения истекают; настроенные ресурсные ограничения и аварийный SSH продолжают действовать."

msgid "proxy-guard-pro:Changes take effect after Save & Apply. When synchronization stops, dynamic leases expire; static and unrestricted rules remain on the VPS."
msgstr "Изменения действуют после «Сохранить и применить». При остановке синхронизации динамические разрешения истекают; статические правила и правила без ограничений остаются на VPS."

msgid "proxy-guard-pro:Check management readiness"
msgstr "Проверить готовность канала управления"

msgid "proxy-guard-pro:Check the access settings and connection."
msgstr "Проверьте настройки доступа и подключения."

msgid "proxy-guard-pro:Checking the VPS capability and applying a temporary policy..."
msgstr "Проверка возможностей VPS и временное применение политики…"

msgid "proxy-guard-pro:Choose a supported protection mode for this port rule."
msgstr "Выберите поддерживаемый режим защиты для этого правила портов."

msgid "proxy-guard-pro:Choose the public address families to authorize dynamically. Removing a family revokes its dynamic lease after the VPS confirms the update; static rules remain independent."
msgstr "Выберите семейства публичных адресов для динамической авторизации. При удалении семейства его динамическое разрешение отзывается после подтверждения VPS; статические правила независимы."

msgid "proxy-guard-pro:Cloudflare Worker and Tunnel"
msgstr "Cloudflare Worker и Tunnel"

msgid "proxy-guard-pro:Concurrent connection limit"
msgstr "Ограничение одновременных соединений"

msgid "proxy-guard-pro:Concurrent connection threshold exceeded"
msgstr "Порог одновременных соединений превышен"

msgid "proxy-guard-pro:Configuration changed elsewhere. Review saved settings and VPS state before applying again."
msgstr "Настройки изменены в другом месте. Перед повторным применением проверьте сохранённые настройки и состояние VPS."

msgid "proxy-guard-pro:Configure observation ports and capture duration on the VPS Agent. Raw evidence and honeypots require Pro Max."
msgstr "Настройте порты наблюдения и время захвата в VPS Agent. Исходные доказательства и honeypot требуют Pro Max."

msgid "proxy-guard-pro:Confirm VPS policy"
msgstr "Подтверждение политики VPS"

msgid "proxy-guard-pro:Confirm VPS policy changes before keeping them"
msgstr "Подтверждать изменения политики VPS перед сохранением"

msgid "proxy-guard-pro:Confirm that the synchronization domain uses a direct connection."
msgstr "Подтвердите, что домен синхронизации использует прямое соединение."

msgid "proxy-guard-pro:Confirm the SSH management session in settings"
msgstr "Подтвердите сеанс управления SSH в настройках"

msgid "proxy-guard-pro:Confirmation result is unknown. Checking again without repeating policy changes."
msgstr "Результат подтверждения неизвестен. Проверка продолжается без повторного изменения политики."

msgid "proxy-guard-pro:Connect by SSH from an authorized management address, then check again"
msgstr "Подключитесь по SSH с авторизованного адреса управления, затем проверьте еще раз"

msgid "proxy-guard-pro:Connection burst allowance"
msgstr "Допустимый всплеск новых соединений"

msgid "proxy-guard-pro:Connection settings"
msgstr "Параметры подключения"

msgid "proxy-guard-pro:Control channel"
msgstr "Канал управления"

msgid "proxy-guard-pro:Control heartbeat age (seconds)"
msgstr "Время с последнего контрольного сигнала управления (сек.)"

msgid "proxy-guard-pro:Control request timeout (seconds)"
msgstr "Время ожидания управляющего запроса (сек.)"

msgid "proxy-guard-pro:Control service HTTPS address"
msgstr "HTTPS-адрес службы управления"

msgid "proxy-guard-pro:Default port protection mode"
msgstr "Режим защиты портов по умолчанию"

msgid "proxy-guard-pro:Device ID"
msgstr "ID устройства"

msgid "proxy-guard-pro:Device secret"
msgstr "Секретный ключ устройства"

msgid "proxy-guard-pro:Direct HTTPS to Agent"
msgstr "Прямой HTTPS к Agent"

msgid "proxy-guard-pro:Discovered listeners"
msgstr "Обнаруженные прослушиваемые службы"

msgid "proxy-guard-pro:Discovery lists candidate ports only. Whitelist mode requires an authorized source; standard mode applies resource limits; observe mode records without blocking. Unrestricted rules keep the original system firewall behavior."
msgstr "Обнаружение только предлагает порты. В режиме белого списка требуется разрешённый источник; стандартный режим применяет ресурсные ограничения; наблюдение записывает события без блокировки. Правила без ограничений сохраняют поведение системного межсетевого экрана."

msgid "proxy-guard-pro:Dynamic lease duration (seconds)"
msgstr "Срок динамического разрешения (сек.)"

msgid "proxy-guard-pro:Each rule has its own mode, sources, thresholds and timers. Ports grouped in one rule share these settings. Create separate rules for different settings."
msgstr "Для каждого правила можно задать режим, разрешённые источники, пороги и время. Порты одного правила используют общие настройки. Для разных настроек создайте отдельные правила."

msgid "proxy-guard-pro:Emergency access active"
msgstr "Активный аварийный доступ"

msgid "proxy-guard-pro:Emergency source scope"
msgstr "Разрешённые источники аварийного доступа"

msgid "proxy-guard-pro:Enable VPS access rules"
msgstr "Включить правила доступа к VPS"

msgid "proxy-guard-pro:Enable emergency SSH access"
msgstr "Включить аварийный доступ к SSH"

msgid "proxy-guard-pro:Enable proxy-path heartbeat"
msgstr "Включить независимый контрольный сигнал через прокси"

msgid "proxy-guard-pro:Enable the matching action locally and on the VPS Agent first."
msgstr "Сначала разрешите нужное действие и локально, и в VPS Agent."

msgid "proxy-guard-pro:Enabled service rules must not overlap on the same protocol."
msgstr "Включённые правила служб не должны пересекаться по портам одного протокола."

msgid "proxy-guard-pro:Enter 0 to keep rescue open, or an integer from 30 to 3600 seconds."
msgstr "Введите 0 для открытия без ограничения времени или целое число от 30 до 3600 секунд."

msgid "proxy-guard-pro:Enter a control-service HTTPS root URL without a path or credentials."
msgstr "Введите URL-адрес корня HTTPS службы управления без пути или учетных данных."

msgid "proxy-guard-pro:Enter a valid device ID."
msgstr "Введите действительный идентификатор устройства."

msgid "proxy-guard-pro:Enter ports from 1 to 65535, or a port range."
msgstr "Введите порты от 1 до 65535 или диапазон портов."

msgid "proxy-guard-pro:Enter the paired device secret."
msgstr "Введите секретный ключ сопряжённого устройства."

msgid "proxy-guard-pro:Enter the secret for the independent proxy heartbeat."
msgstr "Введите ключ независимого контрольного сигнала через прокси."

msgid "proxy-guard-pro:Enter valid IPv4 or IPv6 addresses or CIDR networks."
msgstr "Введите действительные адреса IPv4 или IPv6 или сети CIDR."

msgid "proxy-guard-pro:Fallback bandwidth monitoring needs a trusted data source configured on the VPS Agent."
msgstr "Наблюдение за полосой соединений fallback требует доверенного источника данных, настроенного в VPS Agent."

msgid "proxy-guard-pro:Fallback bandwidth per direction (bytes per second)"
msgstr "Полоса соединений fallback в каждом направлении (байт/с)"

msgid "proxy-guard-pro:Household IP and static whitelist"
msgstr "Домашний IP и статический белый список"

msgid "proxy-guard-pro:Household public IP"
msgstr "Домашний публичный IP"

msgid "proxy-guard-pro:I have confirmed the control service uses a direct connection"
msgstr "Я подтвердил, что служба управления использует прямое соединение."

msgid "proxy-guard-pro:I have verified an authorized SSH management session"
msgstr "Я проверил авторизованную сессию управления SSH."

msgid "proxy-guard-pro:IP filtering"
msgstr "IP фильтрация"

msgid "proxy-guard-pro:Independent proxy heartbeat"
msgstr "Независимый контрольный сигнал через прокси"

msgid "proxy-guard-pro:Interrupted; not repeated automatically"
msgstr "Прерывание; не повторяется автоматически"

msgid "proxy-guard-pro:Keep VPS policy"
msgstr "Сохранить политику VPS"

msgid "proxy-guard-pro:Last attempt"
msgstr "Последняя попытка"

msgid "proxy-guard-pro:Lease expires"
msgstr "Срок действия разрешения"

msgid "proxy-guard-pro:Leave empty to keep the paired device secret."
msgstr "Оставьте поле пустым, чтобы сохранить ключ сопряжённого устройства."

msgid "proxy-guard-pro:Leave empty to keep the paired secret."
msgstr "Оставьте поле пустым, чтобы сохранить сопряжённый ключ."

msgid "proxy-guard-pro:Limit concurrent connections"
msgstr "Ограничение одновременных соединений"

msgid "proxy-guard-pro:Limit new connection rate"
msgstr "Ограничить скорость новых соединений"

msgid "proxy-guard-pro:Limit verified fallback bandwidth"
msgstr "Ограничить полосу подтверждённых соединений fallback"

msgid "proxy-guard-pro:Local protection could not be prepared; the remote action was not sent."
msgstr "Местная защита не могла быть подготовлена; дистанционное действие не было отправлено."

msgid "proxy-guard-pro:Local settings were restored or synchronization stopped. The remote policy still needs verification."
msgstr "Локальные настройки восстановлены или синхронизация остановлена. Состояние удалённой политики ещё нужно проверить."

msgid "proxy-guard-pro:Maintenance operation"
msgstr "Состояние операции обслуживания"

msgid "proxy-guard-pro:Maintenance record storage needs attention; restart actions are disabled."
msgstr "Хранение записей технического обслуживания требует внимания; действия по перезапуску отключены."

msgid "proxy-guard-pro:Manage SSH access"
msgstr "Управление доступом SSH"

msgid "proxy-guard-pro:Management IP addresses or networks"
msgstr "IP-адреса или сети управления"

msgid "proxy-guard-pro:Management addresses and last household IP"
msgstr "Адреса управления и последний домашний IP"

msgid "proxy-guard-pro:Management check"
msgstr "Проверка управления"

msgid "proxy-guard-pro:Management protection active"
msgstr "Защита доступа к управлению активна"

msgid "proxy-guard-pro:New connection cooldown (seconds)"
msgstr "Пауза приёма новых соединений (сек.)"

msgid "proxy-guard-pro:New connection rate exceeded"
msgstr "Превышена скорость новых соединений"

msgid "proxy-guard-pro:New connections per second"
msgstr "Новые соединения в секунду"

msgid "proxy-guard-pro:New connections temporarily limited"
msgstr "Новые соединения временно ограничены"

msgid "proxy-guard-pro:No protection: bypass enabled"
msgstr "Защита отключена: включён обход"

msgid "proxy-guard-pro:Observation window (seconds)"
msgstr "Окно наблюдения (секунды)"

msgid "proxy-guard-pro:Observe only"
msgstr "Только наблюдение и запись"

msgid "proxy-guard-pro:Only add ports you intend to filter. Selecting a panel, API, or subscription port filters that service too. Services sharing the same IP, protocol, and port cannot be separated by URL path or SNI here. SSH has separate settings."
msgstr "Добавляйте только порты, которые нужно фильтровать. При выборе порта панели, API или подписки ограничения распространятся и на этот сервис. Сервисы с одинаковыми IP, протоколом и портом здесь нельзя разделить по пути URL или SNI. Для SSH предусмотрены отдельные настройки."

msgid "proxy-guard-pro:Only enabled service rules restrict their selected ports. Other ports remain under the existing system firewall. SSH is not managed unless you add a rule."
msgstr "Только включенные правила обслуживания ограничивают выбранные ими порты. Другие порты остаются под существующим системным брандмауэром. SSH не управляется, если не добавить правило."

msgid "proxy-guard-pro:Only selected service ports are managed. Other ports keep the existing system firewall policy. SSH management is separate and disabled by default."
msgstr "Управляются только выбранные порты обслуживания. Другие порты сохраняют существующую политику брандмауэра системы. Управление SSH отделено и отключено по умолчанию."

msgid "proxy-guard-pro:Only the session that applied this policy can confirm it."
msgstr "Подтвердить может только сеанс, применивший эту политику."

msgid "proxy-guard-pro:Open until household authorization is restored"
msgstr "Открыт до восстановления авторизации домашнего IP"

msgid "proxy-guard-pro:Operation failed"
msgstr "Не удалось выполнить операцию"

msgid "proxy-guard-pro:Per-port modes are not supported by the connected service. Update the VPS Agent and, if used, the Cloudflare Worker before applying."
msgstr "Подключённый сервис не поддерживает отдельные режимы для портов. Перед применением обновите VPS Agent и, если используется Cloudflare, Worker."

msgid "proxy-guard-pro:Policy confirmation data could not be read. Review saved settings and VPS state."
msgstr "Не удалось прочитать запись подтверждения политики. Проверьте сохранённые настройки и состояние VPS."

msgid "proxy-guard-pro:Policy revision confirmed"
msgstr "Версия политики подтверждена"

msgid "proxy-guard-pro:Port protection mode"
msgstr "Режим защиты порта"

msgid "proxy-guard-pro:Port ranges must not overlap."
msgstr "Портовые диапазоны не должны перекрываться."

msgid "proxy-guard-pro:Prepare changes"
msgstr "Подготовить изменения"

msgid "proxy-guard-pro:Prepare to remove VPS rules"
msgstr "Подготовить снятие правил VPS"

msgid "proxy-guard-pro:Prepare to turn off this plugin VPS port rules and SSH management while synchronization remains enabled. Save & Apply, then confirm the VPS change. After the VPS confirms removal you may stop synchronization. The system firewall remains in effect."
msgstr "Подготовьте отключение правил портов VPS и управления SSH этого плагина, сохранив синхронизацию. Сохраните и примените настройки, затем подтвердите изменение на VPS. После подтверждённого снятия правил можно остановить синхронизацию. Системный межсетевой экран продолжит действовать."

msgid "proxy-guard-pro:Preserve VPS-initiated connections and their replies. Incoming service connections require an explicit rule or a discovered dynamic rule. Existing inbound connections lose access when authorization expires."
msgstr "Сохраняйте соединения, инициированные VPS, и их ответы. Входящие соединения службы требуют явного правила или обнаруженного динамического правила. Существующие входящие соединения теряют доступ, когда истекает срок авторизации."

msgid "proxy-guard-pro:Preview service rules"
msgstr "Предпросмотр правил служб"

msgid "proxy-guard-pro:Protocol"
msgstr "Протокол"

msgid "proxy-guard-pro:Proxy heartbeat age (seconds)"
msgstr "Время с последнего сигнала через прокси (сек.)"

msgid "proxy-guard-pro:Proxy heartbeat interval (seconds)"
msgstr "Интервал контрольного сигнала через прокси (сек.)"

msgid "proxy-guard-pro:Proxy heartbeat secret"
msgstr "Ключ контрольного сигнала через прокси"

msgid "proxy-guard-pro:Public Internet"
msgstr "Любые источники из Интернета"

msgid "proxy-guard-pro:Public access remaining (seconds)"
msgstr "Осталось публичного аварийного доступа (сек.)"

msgid "proxy-guard-pro:Public emergency window (seconds)"
msgstr "Длительность публичного аварийного доступа (сек.)"

msgid "proxy-guard-pro:REALITY configuration check"
msgstr "Проверка конфигурации REALITY"

msgid "proxy-guard-pro:Reboot VPS"
msgstr "Перезагрузить VPS"

msgid "proxy-guard-pro:Recommended. The VPS restores its previous selected-port policy if a changed policy is not confirmed. Disabling this applies changes immediately."
msgstr "Рекомендуется включить. Если изменение не подтверждено, VPS восстановит предыдущую политику выбранных портов. При отключении изменения применяются сразу."

msgid "proxy-guard-pro:Recovery verification timeout (seconds)"
msgstr "Тайм-аут проверки восстановления (секунды)"

msgid "proxy-guard-pro:Recovery verified"
msgstr "Восстановление проверено"

msgid "proxy-guard-pro:Recovery was not verified before the timeout."
msgstr "Восстановление не было проверено до тайм-аута."

msgid "proxy-guard-pro:Reduce the number of rules or whitelist addresses."
msgstr "Уменьшите число правил или адресов в белом списке."

msgid "proxy-guard-pro:Remote maintenance"
msgstr "Удалённое обслуживание"

msgid "proxy-guard-pro:Remove VPS rules"
msgstr "Снять правила VPS"

msgid "proxy-guard-pro:Request accepted"
msgstr "Запрос принят"

msgid "proxy-guard-pro:Require VPS service health before restoring access"
msgstr "Требовать исправности служб VPS перед восстановлением доступа"

msgid "proxy-guard-pro:Resource threshold exceeded"
msgstr "Превышен порог использования ресурсов"

msgid "proxy-guard-pro:Restart proxy core"
msgstr "Перезапустить ядро прокси"

msgid "proxy-guard-pro:Restore previous VPS policy"
msgstr "Восстановить предыдущую политику VPS"

msgid "proxy-guard-pro:Restrict listed ports only"
msgstr "Ограничение только перечисленных портов"

msgid "proxy-guard-pro:Result unknown"
msgstr "Результат неизвестен"

msgid "proxy-guard-pro:SSH authentication settings remain unchanged. Access is managed only after both heartbeats and an authorized SSH session are verified."
msgstr "Настройки аутентификации SSH не меняются. Управление доступом включается только после проверки обоих контрольных сигналов и разрешённого сеанса SSH."

msgid "proxy-guard-pro:SSH management"
msgstr "Управление SSH"

msgid "proxy-guard-pro:SSH on TCP port 22 is enabled without IP filtering by default. Unrestricted mode adds no source restriction and does not override the system firewall. Unsynchronized address families remain blocked for dynamic rules."
msgstr "SSH на TCP-порте 22 включен без IP-фильтрации по умолчанию. Неограниченный режим не добавляет ограничения источника и не переопределяет системный брандмауэр. Несинхронизированные семейства адресов остаются заблокированными для динамических правил."

msgid "proxy-guard-pro:SSH port"
msgstr "Порт SSH"

msgid "proxy-guard-pro:SSH rescue requires an independent HTTPS heartbeat through the proxy."
msgstr "Аварийный доступ SSH требует независимого контрольного сигнала HTTPS через прокси."

msgid "proxy-guard-pro:Selected address families authorized"
msgstr "Выбранные семейства адресов разрешены"

msgid "proxy-guard-pro:Service name"
msgstr "Название службы"

msgid "proxy-guard-pro:Service rule preview"
msgstr "Предпросмотр правил служб"

msgid "proxy-guard-pro:Settings changed during synchronization; waiting for the next update."
msgstr "Настройки менялись во время синхронизации; ожидание следующего обновления."

msgid "proxy-guard-pro:Standard resource protection"
msgstr "Стандартная защита ресурсов"

msgid "proxy-guard-pro:Static IP addresses or networks"
msgstr "Статические IP-адреса или сети"

msgid "proxy-guard-pro:Static whitelist"
msgstr "Статический белый список"

msgid "proxy-guard-pro:Synchronization failed; check the direct connection, device secret and control service."
msgstr "Синхронизация не удалась; проверьте прямое соединение, секрет устройства и службу управления."

msgid "proxy-guard-pro:Synchronization interval (seconds)"
msgstr "Интервал синхронизации (сек.)"

msgid "proxy-guard-pro:Synchronization is off"
msgstr "Синхронизация отключена"

msgid "proxy-guard-pro:Synchronization is off. The following VPS policy is last known state, not a current confirmation. Rules may remain active and dynamic authorizations expire."
msgstr "Синхронизация отключена. Ниже показана последняя известная политика VPS, а не подтверждение текущего состояния. Правила могут продолжать действовать, а динамические разрешения истекают."

msgid "proxy-guard-pro:Synchronization needs attention"
msgstr "Синхронизация требует внимания"

msgid "proxy-guard-pro:Synchronization stopped"
msgstr "Синхронизация остановлена"

msgid "proxy-guard-pro:Synchronization updates are delayed; protection cannot be confirmed."
msgstr "Обновления синхронизации задерживаются, защита не может быть подтверждена."

msgid "proxy-guard-pro:Synchronize with the VPS"
msgstr "Синхронизировать с VPS"

msgid "proxy-guard-pro:Synchronize your household public IP and inspect VPS service health through direct HTTPS or Cloudflare. Proxy traffic connects directly to the VPS."
msgstr "Синхронизация домашнего публичного IP и проверка состояния служб VPS через прямой HTTPS или Cloudflare. Прокси-трафик подключается непосредственно к VPS."

msgid "proxy-guard-pro:Synchronize your household public IP through a Cloudflare Worker and Tunnel. Proxy traffic continues to connect directly to the VPS."
msgstr "Синхронизируйте свой общедоступный IP-адрес через Cloudflare Worker и Tunnel. Прокси-трафик продолжает подключаться непосредственно к VPS."

msgid "proxy-guard-pro:Synchronizing with the VPS"
msgstr "Синхронизация с VPS"

msgid "proxy-guard-pro:The Agent denied this action; check its local permissions and credentials."
msgstr "Agent отклонил действие; проверьте его локальные разрешения и учётные данные."

msgid "proxy-guard-pro:The SSH port must not overlap a managed proxy service."
msgstr "Порт SSH не должен перекрывать управляемый прокси-сервис."

msgid "proxy-guard-pro:The SSH rescue timeout must allow two heartbeat intervals plus the request timeout."
msgstr "Тайм-аут аварийного SSH должен включать два интервала контрольных сигналов и тайм-аут запроса."

msgid "proxy-guard-pro:The VPS Agent must also explicitly allow each action. A request being accepted does not mean recovery is complete."
msgstr "Агент VPS также должен явно разрешать каждое действие. Принимаемый запрос не означает, что восстановление завершено."

msgid "proxy-guard-pro:The VPS did not confirm the requested inbound policy and address families."
msgstr "VPS не подтвердил запрошенную политику входящего доступа и семейства адресов."

msgid "proxy-guard-pro:The VPS owns this timer. Closing this page, losing the control link or rebooting before confirmation does not keep an unconfirmed policy."
msgstr "Таймер работает на VPS. Закрытие страницы, потеря управляющего соединения или перезагрузка до подтверждения не сохраняют неподтверждённую политику."

msgid "proxy-guard-pro:The connected Agent does not enable Pro Max analysis"
msgstr "Связанный агент не позволяет анализировать Pro Max"

msgid "proxy-guard-pro:The control request must bypass the proxy. Configure direct routing before enabling synchronization. A detected proxy exit is rejected."
msgstr "Запросы управления должны обходить прокси. Перед включением синхронизации настройте прямой маршрут. Если обнаружен адрес выхода прокси, запрос отклоняется."

msgid "proxy-guard-pro:The control service did not confirm this update."
msgstr "Служба контроля не подтвердила это обновление."

msgid "proxy-guard-pro:The control service observed the proxy exit. Configure a direct connection before synchronizing."
msgstr "Служба управления наблюдала выход прокси. Настройка прямого соединения перед синхронизацией."

msgid "proxy-guard-pro:The lease must be at least twice the synchronization interval."
msgstr "Срок разрешения должен быть не меньше двух интервалов синхронизации."

msgid "proxy-guard-pro:The listener list is truncated. Discovery does not change access rules."
msgstr "Список прослушиваемых служб сокращён. Обнаружение не меняет правила доступа."

msgid "proxy-guard-pro:The previous VPS policy was restored after an unconfirmed change."
msgstr "После неподтверждённого изменения восстановлена предыдущая политика VPS."

msgid "proxy-guard-pro:The request result is unknown; checking operation status without repeating it."
msgstr "Результат запроса неизвестен; проверка состояния операции без ее повторения."

msgid "proxy-guard-pro:The selected SSH port is not owned by a verified SSH service"
msgstr "Выбранный порт SSH не принадлежит проверенной службе SSH."

msgid "proxy-guard-pro:The synchronization process is not updating its status."
msgstr "Процесс синхронизации не обновляет свой статус."

msgid "proxy-guard-pro:This interrupts proxy access. Local protection is prepared before the request is sent."
msgstr "Это прерывает доступ к прокси. Местная защита подготовлена до отправки запроса."

msgid "proxy-guard-pro:This preview has not been applied. Unselected ports keep the existing system firewall policy."
msgstr "Этот предварительный просмотр ещё не применён. Для невыбранных портов сохраняются действующие правила системного межсетевого экрана."

msgid "proxy-guard-pro:Unrestricted"
msgstr "неограниченный"

msgid "proxy-guard-pro:Unrestricted bypasses filtering for this rule. Whitelist mode uses allowed sources; standard mode enforces limits; observe mode records threshold events without blocking."
msgstr "«Без ограничений» отключает фильтрацию для этого правила. Белый список разрешает указанные источники; стандартный режим применяет ограничения; наблюдение регистрирует превышения без блокировки."

msgid "proxy-guard-pro:Update the VPS Agent and Cloudflare Worker before using the new source options."
msgstr "Перед использованием новых вариантов источников обновите VPS Agent и Cloudflare Worker."

msgid "proxy-guard-pro:Update the VPS Agent and Worker to use policy confirmation."
msgstr "Для подтверждения политики обновите VPS Agent и Worker."

msgid "proxy-guard-pro:Update the VPS Agent and control service to the matching protocol version."
msgstr "Обновите VPS Agent и службу управления до совместимой версии протокола."

msgid "proxy-guard-pro:Use an Agent HTTPS endpoint reached through the local SOCKS proxy, separately from the control channel."
msgstr "Используйте HTTPS-адрес Agent, доступный через локальный SOCKS отдельно от канала управления."

msgid "proxy-guard-pro:Use default mode"
msgstr "Использовать режим по умолчанию"

msgid "proxy-guard-pro:VPS access readiness"
msgstr "Готовность доступа к VPS"

msgid "proxy-guard-pro:VPS access rules"
msgstr "Правила доступа к VPS"

msgid "proxy-guard-pro:VPS access rules are off"
msgstr "Правила доступа VPS отключены"

msgid "proxy-guard-pro:VPS confirmation window (seconds)"
msgstr "Окно подтверждения VPS (секунды)"

msgid "proxy-guard-pro:VPS confirmed protection bypass for:"
msgstr "VPS подтвердил обход защиты для правил: "

msgid "proxy-guard-pro:VPS confirmed the update"
msgstr "VPS подтвердил обновление"

msgid "proxy-guard-pro:VPS firewall policy restored"
msgstr "Политика брандмауэра VPS восстановлена"

msgid "proxy-guard-pro:VPS firewall verification failed"
msgstr "Проверка брандмауэра VPS провалилась"

msgid "proxy-guard-pro:VPS health check interval (seconds)"
msgstr "Интервал проверки здоровья VPS (секунды)"

msgid "proxy-guard-pro:VPS inbound policy"
msgstr "Политика входящего доступа VPS"

msgid "proxy-guard-pro:VPS policy applied. Seconds remaining to confirm:"
msgstr "Политика VPS временно применена. Осталось секунд для подтверждения: "

msgid "proxy-guard-pro:VPS policy does not match selected-port protection; update the Agent."
msgstr "Политика VPS не соответствует защите выбранного порта; обновите Агента."

msgid "proxy-guard-pro:VPS policy is waiting for confirmation"
msgstr "Политика VPS ожидает подтверждения"

msgid "proxy-guard-pro:VPS policy was restored. Review the reloaded settings."
msgstr "Политика VPS восстановлена. Проверьте повторно загруженные настройки."

msgid "proxy-guard-pro:VPS service monitor failed"
msgstr "Не удалось проверить службы VPS"

msgid "proxy-guard-pro:VPS service rules"
msgstr "Правила доступа к службам VPS"

msgid "proxy-guard-pro:VPS service verification failed"
msgstr "Проверка сервиса VPS провалилась"

msgid "proxy-guard-pro:VPS services"
msgstr "Службы VPS"

msgid "proxy-guard-pro:VPS services are ready"
msgstr "Службы VPS готовы"

msgid "proxy-guard-pro:Verified fallback bandwidth threshold exceeded"
msgstr "Превышен порог полосы подтверждённых соединений fallback"

msgid "proxy-guard-pro:Verifying recovery"
msgstr "Проверка восстановления"

msgid "proxy-guard-pro:Wait briefly before starting another maintenance operation."
msgstr "Ненадолго подождите, прежде чем начать новую операцию по техническому обслуживанию."

msgid "proxy-guard-pro:Wait until the VPS finishes applying the policy."
msgstr "Дождитесь завершения применения политики на VPS."

msgid "proxy-guard-pro:Waiting for a fresh Agent report"
msgstr "В ожидании свежего отчета агента"

msgid "proxy-guard-pro:Waiting for a fresh household IP authorization"
msgstr "В ожидании новой домашней IP-авторизации"

msgid "proxy-guard-pro:Waiting for both authenticated heartbeats"
msgstr "Ожидание обоих аутентифицированных контрольных сигналов"

msgid "proxy-guard-pro:Waiting for management verification"
msgstr "Ожидание проверки канала управления"

msgid "proxy-guard-pro:Waiting for the VPS to confirm the result."
msgstr "Ожидание подтверждения результата от VPS."

msgid "proxy-guard-pro:Waiting to synchronize"
msgstr "В ожидании синхронизации"

msgid "proxy-guard-pro:Warning: a timed window closes public access when it expires. If your IP has changed and no allowed management source is reachable, you may lose SSH access. An unlimited window keeps SSH publicly reachable during the outage; SSH authentication and the system firewall still apply."
msgstr "Предупреждение: по истечении заданного времени публичный доступ закрывается. Если ваш IP изменился и нет доступного разрешённого адреса управления, вы можете потерять доступ по SSH. Без ограничения времени SSH остаётся доступным из интернета на время сбоя; аутентификация SSH и системный межсетевой экран продолжают действовать."

msgid "proxy-guard-pro:Whitelist mode requires household or static authorized sources."
msgstr "Для режима белого списка нужны домашние или статические разрешённые источники."

msgid "proxy-guard-pro:Whitelist only"
msgstr "Только белый список"
