msgstr "；最終読み取り："

msgid "; last restart:"
msgstr "；前回の再起動理由："

msgid "; monitors recovered after restart"
msgstr "；再起動後に監視プロセスが復旧しました"

msgid "; observation completed"
msgstr "；監視完了"

msgid "; observed"
msgstr "；検出値 "

