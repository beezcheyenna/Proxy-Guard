msgstr "؛ در انتظار برقراری دسترسی"

msgid "A confirmation action is already being verified."
msgstr "نتیجهٔ یک اقدام تأیید در حال بررسی است."

msgid "A maintenance operation is already pending."
msgstr "یک عملیات نگهداری از قبل در انتظار اجراست."

msgid "A missing or failed remote health report withholds the local access permit. Local proxy checks remain required."
msgstr "نبودن گزارش سلامت راه دور یا ناموفق‌بودن آن، مانع صدور مجوز دسترسی محلی می‌شود. بررسی‌های محلی پراکسی همچنان الزامی‌اند."

msgid "A package operation is in progress. Try again when it finishes."
msgstr "عملیات بسته در حال انجام است. پس از پایان آن دوباره تلاش کنید."

msgid "A required proxy client service stopped or restarted; protection triggered"
msgstr "سرویس لازم کلاینت پراکسی متوقف یا دوباره راه‌اندازی شد؛ حفاظت فعال شد"

msgid "Accepts a plain-text IPv4 address or a Cloudflare trace response containing ip and colo. Requests always use the local SOCKS proxy; an unreachable service or unexpected exit counts as a failure."
msgstr "پاسخ باید IPv4 متنی یا پاسخ trace مربوط به Cloudflare با فیلدهای ip و colo باشد. درخواست‌ها همیشه از SOCKS محلی عبور می‌کنند؛ در دسترس نبودن سرویس یا متفاوت‌بودن خروجی، شکست محسوب می‌شود."

msgid "Access is allowed during enhanced monitoring; a failure blocks it again"
msgstr "هنگام پایش دقیق، دسترسی مجاز است؛ بروز اختلال آن را دوباره مسدود می‌کند"

msgid "Access permit expired; Internet access is blocked pending proxy revalidation"
msgstr "مجوز دسترسی منقضی شد؛ اینترنت تا اعتبارسنجی دوبارهٔ پراکسی مسدود است"

msgid "Access permit expired; awaiting proxy health verification"
msgstr "مجوز دسترسی منقضی شد؛ در انتظار تأیید سلامت پراکسی"

msgid "Access recovery"
msgstr "شرایط برقراری دسترسی"

msgid "Activation parameters are valid. The runtime environment is checked when applying."
msgstr "پارامترهای فعال‌سازی معتبر هستند. محیط اجرا هنگام اعمال بررسی می‌شود."

msgid "Active kernel flowtables"
msgstr "جدول‌های فعال تخلیهٔ جریان در هسته"

msgid "Add at least one address to an enabled static whitelist."
msgstr "حداقل یک آدرس را به یک لیست سفید استاتیک فعال اضافه کنید."

msgid "Address families"
msgstr "خانواده‌های نشانی"

msgid "After recovery, allow Internet access while checking at one-second intervals during observation. Any failure blocks access and restarts the delay. Disabling observation still requires the original recovery checks."
msgstr "پس از بازیابی، دسترسی به اینترنت برقرار می‌شود و در دورهٔ پایش دقیق، بررسی‌ها با فاصلهٔ یک ثانیه انجام می‌شوند. هر خطا دسترسی را مسدود می‌کند و دورهٔ انتظار را از نو آغاز می‌کند. غیرفعال‌کردن این دوره، بررسی‌های معمول بازیابی را حذف نمی‌کند."

msgid "Agent HTTPS address through the proxy"
msgstr "نشانی HTTPS عامل از طریق پراکسی"

msgid "Agent started"
msgstr "Agent راه‌اندازی شد"

msgid "All IPv6 sources on selected ingress devices"
msgstr "همهٔ مبدأهای IPv6 در رابط‌های ورودی انتخاب‌شده"

msgid "All configured services stop or restart"
msgstr "توقف یا راه‌اندازی مجدد همهٔ سرویس‌های پیکربندی‌شده"

msgid "All configured services stopped"
msgstr "همهٔ سرویس‌های پیکربندی‌شده متوقف شده‌اند"

msgid "All sources keeps standard resource limits active. Household and static addresses are allowed in whitelist mode and exempt from standard limits. Legacy bypass disables this rule protection."
msgstr "برای همهٔ مبدأها محدودیت منابع استاندارد فعال می‌ماند. نشانی‌های خانگی و ثابت در حالت فهرست مجاز اجازهٔ دسترسی دارند و در حالت استاندارد معاف‌اند. گزینهٔ قدیمی دور زدن، حفاظت این قاعده را غیرفعال می‌کند."

msgid "All sources, resource limits apply"
msgstr "همهٔ مبدأها، با اعمال محدودیت منابع"

msgid "All three services stop or restart"
msgstr "توقف یا راه‌اندازی مجدد هر سه سرویس"

msgid "All three services stopped"
msgstr "هر سه سرویس متوقف شد"

msgid "Allow rebooting the VPS"
msgstr "اجازهٔ راه‌اندازی مجدد VPS"

msgid "Allow restarting the proxy core"
msgstr "اجازهٔ راه‌اندازی مجدد هستهٔ پراکسی"

msgid "Allowed LAN IPv4 networks"
msgstr "شبکه‌های IPv4 مجاز در شبکهٔ محلی"

msgid "Allowed LAN IPv6 networks"
msgstr "شبکه‌های IPv6 مجاز در شبکهٔ محلی"

msgid "Allowed or exempt sources"
msgstr "مبدأهای مجاز یا معاف از محدودیت"

msgid "Allowing time for checks to start"
msgstr "در انتظار شروع بررسی‌ها"

msgid "An error occurred while saving the form:"
msgstr "هنگام ذخیرهٔ فرم خطایی رخ داد:"

msgid "An independent watchdog checks plugin heartbeats every five seconds using a clock unaffected by wall-clock adjustments. It restarts this plugin after persistent heartbeat or execution failures. Proxy outages and configuration errors do not trigger restart loops. Manual stop and disabling protection take precedence."
msgstr "پایشگر مستقل هر پنج ثانیه پیام سلامت افزونه را با ساعتی بررسی می‌کند که تغییر ساعت سیستم بر آن اثر ندارد. اگر پیام سلامت یا اجرای افزونه پیوسته ناموفق باشد، همین افزونه را دوباره راه‌اندازی می‌کند. قطع پراکسی و خطای پیکربندی باعث حلقهٔ راه‌اندازی مجدد نمی‌شوند. توقف دستی و غیرفعال‌کردن حفاظت اولویت دارند."

msgid "An nft flowtable is active; existing connections may bypass blocking. Check and disable flow offloading first."
msgstr "یک flowtable در nft فعال است؛ اتصال‌های موجود ممکن است مسدودسازی را دور بزنند. ابتدا تخلیهٔ جریان را بررسی و غیرفعال کنید."

msgid "Analysis Agent connected"
msgstr "عامل تحلیل متصل شد"

msgid "Analysis event"
msgstr "رویداد تحلیل"

msgid "Analysis reports observations and suspicion only. A repeated payload does not identify the sender as GFW. Full packet capture and the honeypot are off by default and configured on the Agent."
msgstr "تحلیل فقط مشاهدات و موارد مشکوک را گزارش می‌کند. تکرار محتوای بسته، فرستنده را به‌عنوان GFW شناسایی نمی‌کند. ضبط کامل بسته و honeypot به‌طور پیش‌فرض غیرفعال‌اند و در Agent تنظیم می‌شوند."

msgid "Another VPS policy change is awaiting confirmation."
msgstr "تغییر دیگری در سیاست VPS در انتظار تأیید است."

msgid "Another configuration transaction is active"
msgstr "تأیید پیکربندی دیگری در حال انجام است"

msgid "Another session is checking configuration"
msgstr "نشست دیگری در حال بررسی پیکربندی است"

msgid "Another session is confirming the VPS policy."
msgstr "نشست دیگری در حال تأیید سیاست VPS است."

msgid "Another settings update is in progress; retry shortly."
msgstr "به‌روزرسانی دیگری برای تنظیمات در حال انجام است؛ کمی بعد دوباره تلاش کنید."

msgid "Any interruption during sensitive recovery restarts the wait and stability timer. Disabling this option still requires the original consecutive recovery checks."
msgstr "هر اختلال در دورهٔ پایش دقیق، زمان انتظار و شمارش پایداری را از نو آغاز می‌کند. حتی با غیرفعال‌کردن این گزینه، بررسی‌های موفق متوالی برای بازیابی لازم‌اند."

msgid "Any service stops or restarts"
msgstr "توقف یا راه‌اندازی مجدد هر یک از سرویس‌ها"

msgid "Apply failed"
msgstr "اعمال تنظیمات ناموفق بود"

msgid "At boot or activation, block Internet access for protected devices while waiting for TCP, UDP and DNS to start, then keep blocking for the configured delay without external probes. Validate the proxy before restoring access and starting enhanced monitoring. This replaces the fixed startup grace period. Router-originated traffic, LAN and DNS remain available."
msgstr "هنگام بوت یا فعال‌سازی، اینترنت دستگاه‌های تحت حفاظت تا راه‌اندازی TCP، UDP و DNS مسدود است؛ سپس انتظار پیکربندی‌شده بدون بررسی خارجی اجرا می‌شود. پیش از برقراری دسترسی و پایش دقیق، پراکسی اعتبارسنجی می‌شود. این روند جایگزین مهلت ثابت راه‌اندازی است. ترافیک خود روتر، شبکهٔ محلی و DNS حفظ می‌شود."

msgid "At boot or activation, block protected devices until the selected client configured services start, then wait without external probes. Validate the proxy before restoring access and beginning enhanced monitoring. Router, LAN and DNS remain available."
msgstr "هنگام بوت یا فعال‌سازی، اینترنت دستگاه‌های تحت حفاظت تا راه‌اندازی سرویس‌های پیکربندی‌شدهٔ کلاینت انتخابی مسدود می‌ماند؛ سپس دورهٔ انتظار بدون بررسی خارجی اجرا می‌شود. پیش از برقراری دسترسی و آغاز پایش دقیق، پراکسی اعتبارسنجی می‌شود. دسترسی خود روتر، شبکهٔ محلی و DNS حفظ می‌شود."

msgid "Attempt interrupted; routine exit verification continues"
msgstr "تلاش قطع شد؛ اعتبارسنجی معمول خروجی ادامه دارد"

msgid "Attention required"
msgstr "نیازمند بررسی"

msgid "Authentication failed"
msgstr "احراز هویت ناموفق بود"

msgid "Authorization updated"
msgstr "مجوز به‌روز شد"

msgid "Automatic client detection is ambiguous or unavailable. Select the client and verify the listener ports."
msgstr "تشخیص خودکار کلاینت پراکسی ناممکن یا مبهم است. کلاینت را انتخاب و درگاه‌های شنونده را بررسی کنید."

msgid "Automatic detection"
msgstr "تشخیص خودکار"

msgid "Automatic recovery cooldown"
msgstr "حداقل فاصلهٔ بازیابی‌های خودکار"

msgid "Automatic recovery counting window"
msgstr "بازهٔ شمارش بازیابی‌های خودکار"

msgid "Automatic recovery is off"
msgstr "بازیابی خودکار غیرفعال است"

msgid "Automatic recovery limit"
msgstr "محدودیت بازیابی خودکار"

msgid "Automatic recovery limit reached; retaining protection while waiting"
msgstr "سقف بازیابی خودکار رسیده است؛ حفاظت هنگام انتظار حفظ می‌شود"

msgid "Automatic restart limit reached"
msgstr "سقف دفعات راه‌اندازی مجدد خودکار رسیده است"

msgid "Automatically restart unresponsive plugin monitors"
msgstr "راه‌اندازی مجدد خودکار فرایندهای پایش بی‌پاسخ افزونه"

msgid "Awaiting verification"
msgstr "در انتظار بررسی"

msgid "Back"
msgstr "قبلی"

msgid "Bandwidth threshold duration (seconds)"
msgstr "مدت عبور از آستانهٔ پهنای باند (ثانیه)"

msgid "Block Internet access on proxy failure"
msgstr "مسدود کردن دسترسی به اینترنت هنگام اختلال پراکسی"

msgid "Block Internet access without external probes during this delay; local service monitoring continues. Disabling this option starts verification immediately."
msgstr "در این دوره، دسترسی اینترنت مسدود است و بررسی خارجی انجام نمی‌شود؛ پایش سرویس‌های محلی ادامه دارد. با غیرفعال‌کردن این گزینه، اعتبارسنجی بی‌درنگ آغاز می‌شود."

msgid "Block before recovery checks"
msgstr "مسدودسازی پیش از بررسی‌های بازیابی"

msgid "Block during startup and proxy failures"
msgstr "مسدود کردن دسترسی هنگام راه‌اندازی و اختلال پراکسی"

msgid "Block these local ports as well, preventing devices with explicit SOCKS settings from bypassing protection."
msgstr "این پورت های محلی را نیز مسدود کنید و از دستگاه هایی با تنظیمات صریح SOCKS از دور زدن محافظت جلوگیری کنید."

msgid "Blocking delay (seconds)"
msgstr "مدت انتظار با مسدودسازی (ثانیه)"

msgid "Blocking is off"
msgstr "مسدودسازی غیرفعال است"

msgid "Boot protection is waiting for TCP, UDP and DNS"
msgstr "حفاظت هنگام راه‌اندازی در انتظار TCP، UDP و DNS است"

msgid "Boot protection is waiting for the configured proxy client services"
msgstr "حفاظت هنگام راه‌اندازی در انتظار سرویس‌های پیکربندی‌شدهٔ کلاینت پراکسی است"

msgid "Boot protection replaces this fixed startup grace period."
msgstr "حفاظت هنگام راه‌اندازی جایگزین این مهلت ثابت می‌شود."

msgid "Boot protection started; waiting for TCP, UDP and DNS; Internet access remains blocked"
msgstr "حفاظت هنگام راه‌اندازی آغاز شد؛ در انتظار TCP، UDP و DNS؛ اینترنت همچنان مسدود است"

msgid "Boot service protection"
msgstr "حفاظت سرویس هنگام راه‌اندازی"

msgid "Both heartbeats lost for (seconds)"
msgstr "مدت قطع هم‌زمان هر دو پیام سلامت (ثانیه)"

msgid "Bridge filtering"
msgstr "فیلترگذاری پل شبکه"

msgid "Bridged traffic enters the IP firewall and may affect switching; blocking is not enabled"
msgstr "ترافیک پل وارد دیوار آتش IP می‌شود و ممکن است بر سوییچینگ اثر بگذارد؛ مسدودسازی فعال نشده است"

msgid "Bypass all protection (legacy behavior)"
msgstr "دور زدن همهٔ حفاظت‌ها (سازگاری با تنظیمات قدیمی)"

msgid "Bytes observed"
msgstr "ترافیک مشاهده‌شده (بایت)"

msgid "CPU (total)"
msgstr "CPU (مجموع)"

msgid "Cancel"
msgstr "لغو"

msgid "Cannot calculate the schedule window"
msgstr "محاسبهٔ بازهٔ برنامه ممکن نیست"

msgid "Cannot commit this session's plugin configuration; check the session and write permissions"
msgstr "ثبت پیکربندی افزونه برای این نشست ممکن نیست؛ نشست و مجوز نوشتن را بررسی کنید"

msgid "Cannot complete self-check"
msgstr "تکمیل خودآزمایی ممکن نیست"

msgid "Cannot open self-check journal lock"
msgstr "بازکردن قفل گزارش خودآزمایی ممکن نیست"

msgid "Cannot open the service protection log lock"
msgstr "بازکردن قفل گزارش حفاظت سرویس ممکن نیست"

msgid "Cannot read PassWall log; service and proxy checks continue"
msgstr "خواندن گزارش PassWall ممکن نیست؛ بررسی سرویس و پراکسی ادامه دارد"

msgid "Cannot read analysis status; retrying automatically."
msgstr "خواندن وضعیت تحلیل ممکن نیست؛ تلاش مجدد خودکار است."

msgid "Cannot read client log; service and proxy checks continue"
msgstr "خواندن گزارش کلاینت ممکن نیست؛ بررسی سرویس و پراکسی ادامه دارد"

msgid "Cannot read confirmation status. The VPS rollback timer continues."
msgstr "خواندن وضعیت تأیید ممکن نیست. زمان‌سنج بازگردانی VPS همچنان فعال است."

msgid "Cannot read firewall rules"
msgstr "خواندن قواعد دیوار آتش ممکن نیست"

msgid "Cannot read plugin logs:"
msgstr "خواندن گزارش‌های افزونه ممکن نیست: "

msgid "Cannot read plugin status"
msgstr "خواندن وضعیت افزونه ممکن نیست"

msgid "Cannot read plugin status or logs"
msgstr "خواندن وضعیت یا گزارش‌های افزونه ممکن نیست"

msgid "Cannot read status; protection cannot be confirmed:"
msgstr "نمی توان وضعیت را خواند؛ حفاظت را نمی توان تایید کرد: "

msgid "Cannot read synchronization status; retrying automatically."
msgstr "خواندن وضعیت همگام‌سازی ممکن نیست؛ تلاش مجدد به‌صورت خودکار انجام می‌شود."

msgid "Cannot read this session's plugin configuration"
msgstr "خواندن پیکربندی افزونه برای این نشست ممکن نیست"

msgid "Cannot remove plugin firewall rules"
msgstr "حذف قواعد دیوار آتش افزونه ممکن نیست"

msgid "Cannot synchronize system firewall protection rules"
msgstr "همگام‌سازی قواعد حفاظتی دیوار آتش سیستم ممکن نیست"

msgid "Cannot verify active flow offloading"
msgstr "تأیید تخلیهٔ جریان فعال ممکن نیست"

msgid "Cannot verify firewall state"
msgstr "تأیید وضعیت دیوار آتش ممکن نیست"

msgid "Cannot verify newly installed rules"
msgstr "تأیید قواعد تازه نصب‌شده ممکن نیست"

msgid "Cannot verify required nftables features; check the firewall and kernel modules"
msgstr "تأیید قابلیت‌های مورد نیاز nftables ممکن نیست؛ دیوار آتش و ماژول‌های هسته را بررسی کنید"

msgid "Capture state"
msgstr "وضعیت ضبط بسته"

msgid "Captured packets"
msgstr "بسته های ضبط شده"

msgid "Changes take effect after Save & Apply. Stopping synchronization does not remove VPS rules. Dynamic authorizations expire; configured resource limits and SSH rescue remain in effect."
msgstr "تغییرات پس از «ذخیره و اعمال» اجرا می‌شوند. توقف همگام‌سازی قواعد VPS را حذف نمی‌کند. مجوزهای پویا منقضی می‌شوند؛ محدودیت منابع و دسترسی اضطراری SSH طبق تنظیمات باقی می‌مانند."

msgid "Changes take effect after Save & Apply. When synchronization stops, dynamic leases expire; static and unrestricted rules remain on the VPS."
msgstr "تغییرات پس از «ذخیره و اعمال» اجرا می‌شوند. با توقف همگام‌سازی، مجوزهای پویا منقضی می‌شوند؛ قواعد ثابت و بدون محدودیت روی VPS باقی می‌مانند."

msgid "Changing only logging options does not restart checks or reset permits. Logs are stored in memory, cleared on reboot, and also sent to the system log."
msgstr "تغییر گزینه‌های گزارش‌گیری به‌تنهایی، بررسی‌ها را دوباره راه‌اندازی نمی‌کند و مجوزها را بازنشانی نمی‌کند. گزارش‌ها در حافظه‌اند، با راه‌اندازی مجدد پاک می‌شوند و به گزارش سیستم نیز فرستاده می‌شوند."

msgid "Check configuration; automatic recovery is paused"
msgstr "پیکربندی را بررسی کنید؛ بازیابی خودکار متوقف شده است"

msgid "Check interval"
msgstr "فاصلهٔ بررسی"

msgid "Check local TCP, UDP and DNS services every second and block protected clients when the selected condition is met. Keep the existing SOCKS, HTTPS and exit IP checks. Traffic initiated by this router, LAN access and DNS remain available."
msgstr "سرویس‌های محلی TCP، UDP و DNS هر ثانیه بررسی می‌شوند و با برقرارشدن شرط انتخابی، اینترنت کلاینت‌های تحت حفاظت مسدود می‌شود. بررسی‌های موجود SOCKS، HTTPS و IP خروجی ادامه دارند. ترافیک خود روتر، دسترسی شبکهٔ محلی و DNS حفظ می‌شود."

msgid "Check local TCP, UDP and DNS services every second. If all three stop, block protected clients immediately. Keep the existing SOCKS, HTTPS and exit IP checks. Traffic initiated by this router, LAN access and DNS remain available."
msgstr "سرویس‌های محلی TCP، UDP و DNS هر ثانیه بررسی می‌شوند. اگر هر سه متوقف شوند، اینترنت کلاینت‌های تحت حفاظت بی‌درنگ مسدود می‌شود. بررسی‌های موجود SOCKS، HTTPS و IP خروجی ادامه دارند. ترافیک خود روتر، دسترسی شبکهٔ محلی و DNS حفظ می‌شود."

msgid "Check management readiness"
msgstr "بررسی آمادگی مسیر مدیریت"

msgid "Check plugin services"
msgstr "بررسی سرویس‌های افزونه"

msgid "Check round cancelled; keeping Internet blocked until revalidation"
msgstr "نوبت بررسی لغو شد؛ اینترنت تا اعتبارسنجی دوباره مسدود می‌ماند"

msgid "Check settings and runtime environment"
msgstr "بررسی تنظیمات و محیط اجرا"

msgid "Check target format must be https://domain/path|status_code"
msgstr "قالب مقصد بررسی باید https://domain/path|status_code باشد"

msgid "Check targets require an HTTPS domain without credentials or custom ports"
msgstr "مقصد بررسی باید دامنهٔ HTTPS بدون اطلاعات ورود یا درگاه سفارشی باشد"

msgid "Check the access settings and connection."
msgstr "تنظیمات دسترسی و اتصال را بررسی کنید."

msgid "Check the selected client every second using its configured TCP, UDP and DNS capabilities. Unconfigured capabilities are shown separately. Keep the existing real proxy checks and preserve router, LAN and DNS access."
msgstr "کلاینت انتخابی هر ثانیه بر اساس قابلیت‌های پیکربندی‌شدهٔ TCP، UDP و DNS بررسی می‌شود. قابلیت‌های پیکربندی‌نشده جدا نمایش داده می‌شوند. بررسی واقعی پراکسی همچنان انجام می‌شود و دسترسی خود روتر، شبکهٔ محلی و DNS حفظ می‌شود."

msgid "Checking the VPS capability and applying a temporary policy..."
msgstr "در حال بررسی قابلیت‌های VPS و اعمال موقت سیاست…"

msgid "Checking the applied configuration and protection rules..."
msgstr "در حال بررسی پیکربندی اعمال‌شده و قواعد حفاظتی…"

msgid "Checking unsaved settings without saving or probing the Internet..."
msgstr "بررسی تنظیمات ذخیره‌نشده، بدون ذخیره‌سازی یا آزمون اینترنت…"

msgid "Checks always use the SOCKS5 proxy on 127.0.0.1, with no direct fallback."
msgstr "بررسی‌ها همیشه از پراکسی SOCKS5 در نشانی 127.0.0.1 انجام می‌شوند و در صورت شکست، اتصال مستقیم جایگزین نمی‌شود."

msgid "Checks and logging"
msgstr "بررسی‌ها و گزارش‌گیری"

msgid "Choose IPv6 scope"
msgstr "محدودهٔ IPv6 را انتخاب کنید"

msgid "Choose a supported protection mode for this port rule."
msgstr "برای این قانون پورت، یک حالت حفاظت پشتیبانی‌شده انتخاب کنید."

msgid "Choose an IPv6 protection scope explicitly."
msgstr "محدودهٔ حفاظت IPv6 را به‌طور مشخص انتخاب کنید."

msgid "Choose any combination of days. An overnight window belongs to its start day: Monday 23:00–01:00 continues into Tuesday morning."
msgstr "هر ترکیبی از روزها را انتخاب کنید. بازهٔ عبوری از نیمه‌شب متعلق به روز آغاز است؛ مثلاً دوشنبه 23:00–01:00 تا صبح سه‌شنبه ادامه دارد."

msgid "Choose the public address families to authorize dynamically. Removing a family revokes its dynamic lease after the VPS confirms the update; static rules remain independent."
msgstr "خانواده‌های نشانی عمومی را برای مجازسازی پویا انتخاب کنید. حذف یک خانواده، پس از تأیید VPS مجوز پویای آن را لغو می‌کند؛ قواعد ثابت مستقل‌اند."

msgid "Clear logs"
msgstr "پاک‌کردن گزارش‌ها"

msgid "Client DNS listener could not be verified"
msgstr "تأیید درگاه شنوندهٔ DNS کلاینت ممکن نیست"

msgid "Client SOCKS authentication could not be prepared"
msgstr "آماده‌سازی احراز هویت SOCKS کلاینت ممکن نیست"

msgid "Client adapter is unavailable"
msgstr "سازگارکنندهٔ کلاینت در دسترس نیست"

msgid "Client lifecycle log changed"
msgstr "گزارش راه‌اندازی و توقف کلاینت تغییر کرده است"

msgid "Client lifecycle log indicates a service or rule change; Internet access blocked pending recovery"
msgstr "گزارش چرخهٔ اجرای کلاینت، تغییر سرویس یا قواعد را نشان می‌دهد؛ دسترسی اینترنت تا بازیابی مسدود است"

msgid "Client listener configuration could not be verified"
msgstr "تأیید پیکربندی درگاه‌های شنوندهٔ کلاینت ممکن نیست"

msgid "Client log monitoring is off"
msgstr "پایش گزارش کلاینت غیرفعال است"

msgid "Client profile limit exceeded"
msgstr "تعداد پیکربندی‌های کلاینت بیش از حد مجاز است"

msgid "Client runtime configuration is unavailable"
msgstr "پیکربندی در حال اجرای کلاینت در دسترس نیست"

msgid "Client startup and configured services are ready; verifying recovery without an extra delay"
msgstr "راه‌اندازی کلاینت و سرویس‌های پیکربندی‌شده آماده‌اند؛ بازیابی بدون انتظار اضافی بررسی می‌شود"

msgid "Close"
msgstr "بستن"

msgid "Cloudflare Worker and Tunnel"
msgstr "Cloudflare Worker و Tunnel"

msgid "Cloudflare data center"
msgstr "مرکز دادهٔ Cloudflare"

msgid "Cloudflare event verification is off"
msgstr "اعتبارسنجی رویداد با Cloudflare غیرفعال است"

msgid "Cloudflare event verification:"
msgstr "تایید رویداد Cloudflare: "

msgid "Cloudflare reported a different exit; waiting for fresh exit verification"
msgstr "Cloudflare یک خروجی متفاوت را گزارش کرد؛ انتظار برای تایید خروجی تازه"

msgid "Combined LAN exemptions must not cover the entire Internet"
msgstr "مجموع استثناهای شبکهٔ محلی نباید کل اینترنت را پوشش دهد"

msgid "Concurrent connection limit"
msgstr "سقف اتصال‌های هم‌زمان"

msgid "Concurrent connection threshold exceeded"
msgstr "تعداد اتصال‌های هم‌زمان از آستانه گذشته است"

msgid "Configuration changed during UDP check; waiting for revalidation"
msgstr "پیکربندی هنگام بررسی UDP تغییر کرد؛ در انتظار اعتبارسنجی دوباره"

msgid "Configuration changed elsewhere. Reload it before saving."
msgstr "تنظیمات در صفحه‌ای دیگر تغییر کرده‌اند. پیش از ذخیره، آن‌ها را دوباره بارگیری کنید."

msgid "Configuration changed elsewhere. Review saved settings and VPS state before applying again."
msgstr "تنظیمات در جای دیگری تغییر کرده‌اند. پیش از اعمال مجدد، تنظیمات ذخیره‌شده و وضعیت VPS را بررسی کنید."

msgid "Configuration format"
msgstr "قالب پیکربندی"

msgid "Configuration is valid."
msgstr "اعتبارسنجی تنظیمات موفق بود."

msgid "Configuration or environment error; protection is unverified"
msgstr "خطای پیکربندی یا محیط اجرا؛ وضعیت حفاظت تأیید نشده است"

msgid "Configuration or ingress device changed during checks; awaiting verification"
msgstr "پیکربندی یا رابط ورودی هنگام بررسی تغییر کرد؛ در انتظار تأیید"

msgid "Configuration requires attention"
msgstr "پیکربندی نیاز به بررسی دارد"

msgid "Configuration snapshot expired. Reload the configuration."
msgstr "مهلت نسخهٔ تنظیمات به پایان رسیده است. تنظیمات را دوباره بارگیری کنید."

msgid "Configure 2–4 targets as https://domain/path|expected_status. Connections use the proxy. This does not test the health of every UDP service."
msgstr "از 2 تا 4 مقصد با قالب https://domain/path|expected_status تعریف کنید. اتصال‌ها از پراکسی عبور می‌کنند. این آزمون سلامت همهٔ سرویس‌های UDP را بررسی نمی‌کند."

msgid "Configure between 1 and 16 DNS service ports"
msgstr "از 1 تا 16 درگاه سرویس DNS تعیین کنید"

msgid "Configure between 2 and 4 HTTPS check targets"
msgstr "از 2 تا 4 مقصد بررسی HTTPS تعیین کنید"

msgid "Configure observation ports and capture duration on the VPS Agent. Raw evidence and honeypots require Pro Max."
msgstr "درگاه‌های مشاهده و مدت ضبط را در VPS Agent تعیین کنید. شواهد خام و honeypot به Pro Max نیاز دارند."

msgid "Configured flow offloading"
msgstr "تخلیهٔ جریان در تنظیمات"

msgid "Configured proxy client services are running; boot protection delay started"
msgstr "سرویس‌های پیکربندی‌شدهٔ کلاینت پراکسی در حال اجرا هستند؛ دورهٔ انتظار محافظت هنگام راه‌اندازی آغاز شد"

msgid "Configured proxy service interrupted"
msgstr "سرویس پراکسی پیکربندی‌شده قطع شده است"

msgid "Confirm"
msgstr "تأیید"

msgid "Confirm VPS policy"
msgstr "تأیید سیاست VPS"

msgid "Confirm VPS policy changes before keeping them"
msgstr "حفظ تغییرات سیاست VPS تنها پس از تأیید"

msgid "Confirm protection settings"
msgstr "تأیید تنظیمات حفاظتی"

msgid "Confirm that the synchronization domain uses a direct connection."
msgstr "تأیید کنید که دامنهٔ همگام‌سازی از اتصال مستقیم استفاده می‌کند."

msgid "Confirm the IPv6 scope independently of IPv4."
msgstr "محدودهٔ IPv6 را مستقل از IPv4 بررسی و تأیید کنید."

msgid "Confirm the SSH management session in settings"
msgstr "تایید جلسه مدیریت SSH در تنظیمات"

msgid "Confirmation result is unknown. Checking again without repeating policy changes."
msgstr "نتیجهٔ تأیید مشخص نیست. بررسی بدون تکرار تغییر سیاست ادامه دارد."

msgid "Confirming consecutive failures"
msgstr "در حال تأیید خطاهای متوالی"

msgid "Confirming proxy recovery"
msgstr "در حال تأیید بازیابی پراکسی"

msgid "Confirming recovery"
msgstr "در حال تأیید بازیابی"

msgid "Connect by SSH from an authorized management address, then check again"
msgstr "از نشانی مدیریتی مجاز با SSH متصل شوید و سپس دوباره بررسی کنید"

msgid "Connection burst allowance"
msgstr "ظرفیت اتصال‌های ناگهانی"

msgid "Connection checks"
msgstr "بررسی‌های اتصال"

msgid "Connection settings"
msgstr "تنظیمات اتصال"

msgid "Connectivity monitor delayed"
msgstr "به‌روزرسانی پایش اتصال تأخیر دارد"

msgid "Connectivity monitor heartbeat expired"
msgstr "مهلت پیام سلامت فرایند پایش اتصال گذشته است"

msgid "Consecutive failed rounds"
msgstr "تعداد بررسی‌های ناموفق متوالی"

msgid "Consecutive successful rounds for recovery"
msgstr "تعداد بررسی‌های موفق متوالی برای بازیابی"

msgid "Continue"
msgstr "ادامه"

msgid "Control channel"
msgstr "کانال کنترل"

msgid "Control heartbeat age (seconds)"
msgstr "زمان سپری‌شده از آخرین پیام سلامت کنترل (ثانیه)"

msgid "Control request timeout (seconds)"
msgstr "مهلت درخواست کنترل (ثانیه)"

msgid "Control service HTTPS address"
msgstr "نشانی HTTPS سرویس کنترل"

msgid "Current protection reason"
msgstr "دلیل حفاظت فعلی"

msgid "Current recovery event"
msgstr "رویداد جاری بازیابی"

msgid "DNS redirect destination ports"
msgstr "درگاه‌های مقصد هدایت DNS"

msgid "DNS service port"
msgstr "درگاه سرویس DNS"

msgid "DNS service ports must not overlap proxy ingress ports"
msgstr "درگاه‌های سرویس DNS نباید با درگاه‌های ورودی پراکسی هم‌پوشانی داشته باشند"

msgid "Days of the week"
msgstr "روزهای هفته"

msgid "Default port protection mode"
msgstr "حالت پیش‌فرض حفاظت پورت"

msgid "Default template"
msgstr "الگوی پیش‌فرض"

msgid "Default: 53. Enter the actual port if existing DNS redirection uses another port. Only requests and replies redirected to local or allowed LAN DNS are exempt. DNS settings are unchanged. Do not overlap proxy ingress ports."
msgstr "پیش‌فرض: 53. اگر هدایت فعلی DNS از درگاه دیگری استفاده می‌کند، شمارهٔ واقعی آن را وارد کنید. فقط درخواست‌ها و پاسخ‌هایی مستثنا هستند که به DNS محلی یا DNS مجاز شبکهٔ محلی هدایت می‌شوند. تنظیمات DNS تغییر نمی‌کند. این درگاه‌ها نباید با درگاه‌های ورودی پراکسی یکسان باشند."

msgid "Delay before checks (seconds)"
msgstr "انتظار پیش از بررسی‌ها (ثانیه)"

msgid "Deny unlisted inbound connections"
msgstr "رد اتصال‌های ورودی فهرست‌نشده"

msgid "Detailed check logs"
msgstr "گزارش‌های تفصیلی بررسی"

msgid "Detect one installed client automatically. When several are installed, select the client to monitor. This does not modify the client configuration."
msgstr "یک کلاینت نصب‌شده خودکار شناسایی می‌شود. اگر چند کلاینت نصب است، یکی را برای پایش انتخاب کنید. پیکربندی کلاینت تغییر نمی‌کند."

msgid "Device ID"
msgstr "شناسهٔ دستگاه"

msgid "Device secret"
msgstr "کلید محرمانهٔ دستگاه"

msgid "Direct HTTPS to Agent"
msgstr "اتصال مستقیم HTTPS به Agent"

msgid "Disabled"
msgstr "غیرفعال"

msgid "Discover listening services automatically"
msgstr "کشف خودکار سرویس‌های شنونده"

msgid "Discovered listeners"
msgstr "سرویس‌های شنوندهٔ شناسایی‌شده"

msgid "Discovered listeners are candidates only; add a service rule to manage a port. Unrestricted rules add no source restriction and do not override the system firewall. Unsynchronized address families remain blocked for dynamic rules."
msgstr "سرویس‌های شنوندهٔ شناسایی‌شده فقط پیشنهادند؛ برای مدیریت درگاه، قاعدهٔ سرویس اضافه کنید. قواعد بدون محدودیت، مبدأ را محدود نمی‌کنند و دیوار آتش سیستم را دور نمی‌زنند. خانواده‌های نشانی همگام‌نشده در قواعد پویا همچنان مسدودند."

msgid "Discovery lists candidate ports only. Whitelist mode requires an authorized source; standard mode applies resource limits; observe mode records without blocking. Unrestricted rules keep the original system firewall behavior."
msgstr "کشف خودکار فقط درگاه‌های پیشنهادی را فهرست می‌کند. حالت فهرست مجاز به مبدأ مجاز نیاز دارد؛ حالت استاندارد محدودیت منابع را اعمال می‌کند؛ حالت مشاهده فقط ثبت می‌کند و مسدود نمی‌کند. قواعد بدون محدودیت، رفتار فعلی دیوار آتش سیستم را حفظ می‌کنند."

msgid "Dismiss"
msgstr "بستن"

msgid "Do not match IPv6 sources"
msgstr "عدم تطبیق مبدأهای IPv6"

msgid "Download configuration"
msgstr "دریافت فایل تنظیمات"

msgid "Download local analysis report"
msgstr "دریافت گزارش تحلیل محلی"

msgid "Download report"
msgstr "دریافت گزارش"

msgid "Dynamic lease duration (seconds)"
msgstr "مدت اعتبار مجوز پویا (ثانیه)"

msgid "Each rule has its own mode, sources, thresholds and timers. Ports grouped in one rule share these settings. Create separate rules for different settings."
msgstr "هر قانون حالت، مبدأهای مجاز، آستانه‌ها و زمان‌بندی‌های مستقل دارد. پورت‌های یک قانون این تنظیمات را به اشتراک می‌گذارند. برای تنظیمات متفاوت، قوانین جداگانه بسازید."

msgid "Edit the complete UCI configuration for this plugin. Save stages changes; Save & Apply validates and activates them. Existing secret values are preserved by placeholders."
msgstr "پیکربندی کامل UCI این افزونه را ویرایش کنید. «ذخیره» فقط تغییرات را موقتاً ثبت می‌کند؛ «ذخیره و اعمال» آن‌ها را اعتبارسنجی و فعال می‌کند. مقادیر محرمانهٔ موجود با جای‌نگهدار حفظ می‌شوند."

msgid "Emergency access active"
msgstr "دسترسی اضطراری فعال"

msgid "Emergency source scope"
msgstr "مبدأهای مجاز دسترسی اضطراری"

msgid "Enable VPS access rules"
msgstr "فعال‌سازی قواعد دسترسی به VPS"

msgid "Enable after Save & Apply"
msgstr "فعال‌سازی پس از ذخیره و اعمال"

msgid "Enable boot protection"
msgstr "فعال‌سازی حفاظت هنگام راه‌اندازی"

msgid "Enable emergency SSH access"
msgstr "فعال‌سازی دسترسی اضطراری SSH"

msgid "Enable enhanced monitoring after recovery"
msgstr "فعال‌سازی پایش دقیق پس از بازیابی"

msgid "Enable protection"
msgstr "فعال‌سازی حفاظت"

msgid "Enable proxy-path heartbeat"
msgstr "فعال‌سازی پیام سلامت مستقل مسیر پراکسی"

msgid "Enable scheduled protection"
msgstr "فعال‌سازی حفاظت زمان‌بندی‌شده"

msgid "Enable the matching action locally and on the VPS Agent first."
msgstr "ابتدا مجوز همان عملیات را هم در تنظیمات محلی و هم در VPS Agent فعال کنید."

msgid "Enabled"
msgstr "فعال"

msgid "Enabled service rules must not overlap on the same protocol."
msgstr "قواعد فعال سرویس نباید روی یک پروتکل، درگاه‌های هم‌پوشان داشته باشند."

msgid "End time"
msgstr "زمان پایان"

msgid "Enhanced checks are running; waiting for continuous stability"
msgstr "بررسی‌های دقیق اجرا می‌شوند؛ در انتظار پایداری پیوسته"

msgid "Enhanced checks are running; waiting for proxy verification"
msgstr "بررسی‌های دقیق اجرا می‌شوند؛ در انتظار تأیید پراکسی"

msgid "Enhanced checks found an interruption; restarting the wait and stability checks"
msgstr "بررسی‌های دقیق قطع ارتباط را تشخیص دادند؛ انتظار و بررسی پایداری از نو آغاز می‌شوند"

msgid "Enhanced monitoring after recovery"
msgstr "پایش دقیق پس از بازیابی"

msgid "Enhanced monitoring completed"
msgstr "پایش دقیق پایان یافت"

msgid "Enhanced monitoring duration (seconds)"
msgstr "مدت پایش دقیق (ثانیه)"

msgid "Enhanced observation period (seconds)"
msgstr "دورهٔ پایش دقیق (ثانیه)"

msgid "Enter 0 to keep rescue open, or an integer from 30 to 3600 seconds."
msgstr "برای باز ماندن دسترسی اضطراری، 0 و برای محدود کردن زمان، عدد صحیحی از 30 تا 3600 ثانیه وارد کنید."

msgid "Enter IPv6 addresses or prefixes, or explicitly choose no IPv6 matching."
msgstr "نشانی‌ها یا پیشوندهای IPv6 را وارد کنید، یا صریحاً عدم تطبیق IPv6 را انتخاب کنید."

msgid "Enter a DNS target before enabling UDP checks"
msgstr "پیش از فعال‌سازی بررسی UDP، مقصد DNS را وارد کنید"

msgid "Enter a Worker HTTPS root URL without a path or credentials."
msgstr "نشانی ریشهٔ HTTPS مربوط به Worker را بدون مسیر یا اطلاعات ورود وارد کنید."

msgid "Enter a control-service HTTPS root URL without a path or credentials."
msgstr "نشانی ریشهٔ HTTPS سرویس کنترل را بدون مسیر یا اطلاعات ورود وارد کنید."

msgid "Enter a valid HH:MM:SS time"
msgstr "زمان معتبر را با قالب HH:MM:SS وارد کنید"

msgid "Enter a valid device ID."
msgstr "یک شناسه معتبر را وارد کنید."

msgid "Enter manually"
msgstr "ورود دستی"

msgid "Enter ports from 1 to 65535, or a port range."
msgstr "درگاهی از 1 تا 65535 یا یک بازهٔ درگاه وارد کنید."

msgid "Enter the paired device secret."
msgstr "کلید محرمانهٔ دستگاه جفت‌شده را وارد کنید."

msgid "Enter the secret for the independent proxy heartbeat."
