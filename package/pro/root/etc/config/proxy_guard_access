config access 'main'
    option enabled '0'
    option policy_enabled '1'
    option default_deny '0'
    option auto_discover '0'
    option endpoint ''
    option transport 'cloudflare'
    option health_interval '10'
    option health_guard '0'
    option device_id 'home'
    option direct_confirmed '0'
    option family 'ipv4'
    option interval '300'
    option ttl '900'
    option timeout '8'
    option revision '1'
    option protection_mode 'standard'
    option path_watch '0'
    option path_endpoint ''
    option path_interval '10'
    option allow_restart '0'
    option allow_reboot '0'
    option maintenance_timeout '180'
    option ssh_managed '0'
    option ssh_confirmed '0'
    option ssh_port '22'
    option ssh_rescue '1'
    option ssh_after '60'
    option ssh_scope 'public'
    option ssh_open_seconds '0'

    option policy_confirm '1'
    option policy_confirm_seconds '60'
