#!/bin/sh
# Wake the independent updater; never modify routes, PassWall or firewall here.
case "${ACTION:-}" in ifup|ifupdate|ifdown) ;; *) exit 0;; esac
[ -d /var/run/proxy-guard-access ] || exit 0
[ ! -e /var/run/proxy-guard-access/stopped ] || exit 0
umask 077
printf wake > /var/run/proxy-guard-access/wake
