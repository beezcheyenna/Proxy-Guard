#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=9
start_service() {
    /usr/libexec/proxy-guard-access-migrate-secrets || return 1
    [ "$(uci -q get proxy_guard_access.main.enabled)" = 1 ] || return 0
    umask 077
    mkdir -p /var/run/proxy-guard-access /var/lock || return 1
    chmod 700 /var/run/proxy-guard-access || return 1
    cat /proc/sys/kernel/random/uuid > /var/run/proxy-guard-access/generation.new || return 1
    mv /var/run/proxy-guard-access/generation.new /var/run/proxy-guard-access/generation || return 1
    rm -f /var/run/proxy-guard-access/stopped
    rmdir /var/run/proxy-guard-access/pending 2>/dev/null || true
    procd_open_instance
    procd_set_param command /usr/libexec/proxy-guard-access daemon
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 3
    procd_close_instance
    procd_open_instance jobs
    procd_set_param command /usr/libexec/proxy-guard-access jobs_daemon
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 3
    procd_close_instance
}
stop_service() {
    umask 077
    mkdir -p /var/run/proxy-guard-access || return 1
    touch /var/run/proxy-guard-access/stopped
    rm -f /var/run/proxy-guard-access/health.json
    cat /proc/sys/kernel/random/uuid > /var/run/proxy-guard-access/generation.new || return 1
    mv /var/run/proxy-guard-access/generation.new /var/run/proxy-guard-access/generation
    rm -f /var/run/proxy-guard-access/headers /var/run/proxy-guard-access/headers.new /var/run/proxy-guard-access/jobs-headers /var/run/proxy-guard-access/jobs-request
}
reload_service() {
    restart
}
service_triggers() {
    procd_add_reload_trigger proxy_guard_access
}
