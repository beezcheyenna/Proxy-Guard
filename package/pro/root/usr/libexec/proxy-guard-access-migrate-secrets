#!/usr/bin/lua
package.path="/usr/lib/?.lua;"..package.path
-- Move supported legacy credentials out of readable committed UCI, even when off.
local uci=require 'uci'
local json=require 'luci.jsonc'
local access=require 'proxy-guard.access'
local function values()
 local c=uci.cursor();assert(c:load('proxy_guard_access'),'config_unavailable')
 return c,c:get('proxy_guard_access','main','device_token'),c:get('proxy_guard_access','main','path_token')
end
local function migrate()
 local c,device,path=values()
 if device==nil and path==nil then return 0 end
 return require('proxy-guard.access-trial').locked(function()
  local current,device,path=values();local count=0
  for _,row in ipairs({{option='device_token',value=device},{option='path_token',value=path,kind='path'}})do
   if row.value~=nil then
    assert(type(row.value)=='string','invalid_device_token')
    if row.value~=''then access.save_secret(row.value,row.kind);count=count+1 end
    current:delete('proxy_guard_access','main',row.option)
   end
  end
  assert(current:commit('proxy_guard_access'),'secret_migration_failed')
  return count
 end)
end
local ok,result=pcall(migrate)
print(json.stringify(ok and {ok=true,migrated=result}or{ok=false,error='secret_migration_failed'}))
os.exit(ok and 0 or 1)
