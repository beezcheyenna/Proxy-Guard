#!/bin/sh
set -eu
umask 077
case "${1:-}" in
    daemon)
        while [ ! -e /var/run/proxy-guard-access/stopped ]; do
            "$0" once >/dev/null 2>&1 || true
            sleep 5
        done
        ;;
    jobs_daemon)
        while [ ! -e /var/run/proxy-guard-access/stopped ]; do
            if [ -f /var/run/proxy-guard-access/pending/job.json ]; then "$0" jobs >/dev/null 2>&1 || true; fi
            sleep 1
        done
        ;;
    once|jobs|egress)
        mkdir -p /var/run/proxy-guard-access /var/lock
        chmod 700 /var/run/proxy-guard-access
        exec ucode /usr/lib/proxy-guard/access-lock.uc "$1"
        ;;
    status|bump|recover_trial) exec lua /usr/lib/proxy-guard/access-main.lua "$1";;
    *) exit 2;;
esac
