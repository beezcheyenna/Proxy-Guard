#!/bin/sh
# Called by package hooks before files or conffiles are removed.
set -eu
umask 077
pg_context=/usr/lib/proxy-guard/opkg-context.uc
[ -r "$pg_context" ] || pg_context=/var/run/proxy-guard/opkg-context.uc
pg_code=0
pg_owner="$(ucode "$pg_context")" || pg_code=$?
[ "$pg_code" = 0 ] || { [ "$pg_code" = 2 ] && exit 0; exit "$pg_code"; }
if [ ! -e /etc/config/proxy_guard_access ] && [ ! -e /usr/share/proxy-guard/feature-pro.json ]; then exit 0; fi
# Serialize all Pro file replacement against the independent watcher.
# The separate updating marker retains its existing required-health semantics.
mkdir -p /var/run/proxy-guard-access
chmod 700 /var/run/proxy-guard-access
printf '%s\n' "$pg_owner" >/var/run/proxy-guard-access/installing.new
mv /var/run/proxy-guard-access/installing.new /var/run/proxy-guard-access/installing
pg_enabled="$(uci -q get proxy_guard_access.main.enabled || true)"
pg_required="$(uci -q get proxy_guard_access.main.health_guard || true)"
if { [ "$pg_enabled" = 1 ] && [ "$pg_required" = 1 ]; } || { [ "$pg_enabled" != 0 ] && [ "$pg_enabled" != 1 ]; }; then
 mkdir -p /var/run/proxy-guard-access
 chmod 700 /var/run/proxy-guard-access
 printf '%s\n' "$pg_owner" >/var/run/proxy-guard-access/updating.new
 mv /var/run/proxy-guard-access/updating.new /var/run/proxy-guard-access/updating
fi
