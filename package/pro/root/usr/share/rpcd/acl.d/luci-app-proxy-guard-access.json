{
  "luci-app-proxy-guard-access": {
    "description": "Manage VPS access rules and read synchronization status",
    "read": {
      "uci": [
        "proxy_guard_access"
      ],
      "ubus": {
        "proxy_guard_access": [
          "status",
          "raw_info"
        ]
      }
    },
    "write": {
      "uci": [
        "proxy_guard_access"
      ],
      "ubus": {
        "proxy_guard_access": [
          "apply",
          "preflight",
          "egress_info",
          "raw_parse",
          "policy_confirm",
          "policy_cancel"
        ]
      }
    }
  },
  "luci-app-proxy-guard-maintenance": {
    "description": "Explicit permission to restart the VPS or proxy core",
    "write": {
      "ubus": {
        "proxy_guard_access": [
          "restart_xray",
          "reboot_vps"
        ]
      }
    }
  }
}
